# ==========================================
# Lingua LMS - Production Environment Configuration
# Salin file ini menjadi .env di server VPS Anda: cp .env.example .env
# ==========================================

# ------------------------------------------
# 1. Konfigurasi Database PostgreSQL Eksternal / Host VPS
# Format: postgres://username:password@host:port/database_name
# ------------------------------------------
DATABASE_URL=postgres://postgres:password@localhost:5432/lang-lms

# ------------------------------------------
# 2. Konfigurasi Backend & Keamanan
# Backend berjalan di host port 3000
# Frontend berjalan di host port 3001
# ------------------------------------------
PORT=3000
NODE_ENV=production
JWT_SECRET=ganti_dengan_random_string_panjang_dan_rahasia_untuk_keamanan_jwt_token_2026
